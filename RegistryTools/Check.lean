/-
Lean Statement Registry — checker
Code licence: Apache-2.0

Usage:  lake exe check <out.json> <Module.Name> [<Module.Name> ...]

For every declaration defined in the given modules it records, as facts:
  * the axioms it depends on (via `Lean.collectAxioms`),
  * whether `sorryAx` appears (sorry / unfinished proof),
  * whether `Lean.ofReduceBool` appears (native_decide),
  * axioms outside the standard three (propext, Classical.choice, Quot.sound),
  * whether its type is a `Prop` (statements must be `def ... : Prop`),
  * the constants it mentions directly, with the module that defines each,
  * which of those are defined inside the registry itself ("custom definitions").
The tool never judges; it only reports. Exit code is 1 if any `sorryAx`,
`Lean.ofReduceBool`, or non-standard axiom is found, so CI can lock the page.
-/
import Lean

open Lean Meta

namespace RegistryCheck

def standardAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

structure DepInfo where
  name : Name
  module : Option Name
  deriving Inhabited

structure DeclReport where
  name : Name
  module : Name
  isProp : Bool
  axioms : Array Name
  usesSorry : Bool
  usesNativeDecide : Bool
  nonStandardAxioms : Array Name
  directDeps : Array DepInfo
  registryDeps : Array Name
  deriving Inhabited

def DepInfo.toJson (d : DepInfo) : Json :=
  Json.mkObj [("name", Json.str (toString d.name)), ("module", match d.module with
    | some m => Json.str (toString m) | none => Json.null)]

def names (a : Array Name) : Json := Json.arr (a.map fun n => Json.str (toString n))

def DeclReport.toJson (r : DeclReport) : Json :=
  Json.mkObj [
    ("name", Json.str (toString r.name)),
    ("module", Json.str (toString r.module)),
    ("is_prop", Json.bool r.isProp),
    ("axioms", names r.axioms),
    ("uses_sorry", Json.bool r.usesSorry),
    ("uses_native_decide", Json.bool r.usesNativeDecide),
    ("non_standard_axioms", names r.nonStandardAxioms),
    ("direct_dependencies", Json.arr (r.directDeps.map DepInfo.toJson)),
    ("registry_dependencies", names r.registryDeps),
    ("ok", Json.bool (!r.usesSorry && !r.usesNativeDecide && r.nonStandardAxioms.isEmpty))
  ]

/-- Module that defines `n`, if it is an imported constant. -/
def moduleOf (env : Environment) (n : Name) : Option Name :=
  env.getModuleIdxFor? n |>.map fun i => env.header.moduleNames[i.toNat]!

/-- Axioms introduced by `native_decide`. Older Lean used `Lean.ofReduceBool`;
current Lean generates a per-use auxiliary axiom whose name contains `native_decide`. -/
def isNativeAxiom (a : Name) : Bool :=
  a == `Lean.ofReduceBool || a == `Lean.trustCompiler ||
    (a.toString.splitOn "native_decide").length > 1

/-- Is `m` a module belonging to the registry (as opposed to Mathlib/Lean)? -/
def isRegistryModule (m : Name) : Bool :=
  m.getRoot == `Conjectures

/-- Transitively collect constants defined in registry modules, starting from `c`. -/
partial def collectRegistryDeps (env : Environment) (c : Name) : StateT NameSet Id Unit := do
  if (← get).contains c then return
  modify (·.insert c)
  match env.find? c with
  | none => return
  | some ci =>
    for d in ci.getUsedConstantsAsSet.toList do
      match moduleOf env d with
      | some m => if isRegistryModule m then collectRegistryDeps env d
      | none => pure ()

def reportDecl (env : Environment) (ci : ConstantInfo) (mod : Name) : MetaM DeclReport := do
  let n := ci.name
  let axs ← collectAxioms n
  -- A statement must literally have type `Prop`.
  let isProp := ci.type.isProp
  let usesSorry := axs.contains ``sorryAx
  let usesNative := axs.any isNativeAxiom
  let nonStd := axs.filter fun a =>
    !standardAxioms.contains a && !isNativeAxiom a && a != ``sorryAx
  let deps := ci.getUsedConstantsAsSet.toList.toArray.qsort (fun a b => a.toString < b.toString)
  let directDeps : Array DepInfo := deps.map fun d => { name := d, module := moduleOf env d }
  let regDeps := ((collectRegistryDeps env n).run {}).2.toList.filter fun d =>
    d != n && !isNativeAxiom d
  let regDeps := regDeps.toArray.qsort (fun a b => a.toString < b.toString)
  return { name := n, module := mod, isProp, axioms := axs, usesSorry,
           usesNativeDecide := usesNative, nonStandardAxioms := nonStd,
           directDeps, registryDeps := regDeps }

/-- Skip auxiliary declarations generated by the elaborator. -/
def isInteresting (n : Name) : Bool :=
  !n.isInternal && !(n.toString.splitOn "._").length > 1

def main (args : List String) : IO UInt32 := do
  match args with
  | out :: mods@(_ :: _) =>
    let modNames := mods.map String.toName
    initSearchPath (← findSysroot)
    let env ← importModules (modNames.map fun m => { module := m }).toArray {} 0
    let mut reports : Array DeclReport := #[]
    for m in modNames do
      let some idx := env.getModuleIdx? m
        | throw <| IO.userError s!"module {m} not found after import"
      let consts := env.header.moduleData[idx.toNat]!.constNames
      for c in consts do
        if isInteresting c then
          if let some ci := env.find? c then
            let (r, _) ← (reportDecl env ci m).toIO { fileName := "<check>", fileMap := default } { env }
            reports := reports.push r
    let okAll := reports.all fun r =>
      !r.usesSorry && !r.usesNativeDecide && r.nonStandardAxioms.isEmpty
    let json := Json.mkObj [
      ("lean_version", Json.str Lean.versionString),
      ("ok", Json.bool okAll),
      ("declarations", Json.arr (reports.map DeclReport.toJson))
    ]
    IO.FS.writeFile out (json.pretty ++ "\n")
    for r in reports do
      let status := if r.usesSorry || r.usesNativeDecide || !r.nonStandardAxioms.isEmpty
        then "FAIL" else "ok"
      IO.println s!"[{status}] {r.name} : axioms = {r.axioms}"
    return if okAll then 0 else 1
  | _ =>
    IO.eprintln "usage: lake exe check <out.json> <Module> [<Module> ...]"
    return 2

end RegistryCheck

def main := RegistryCheck.main
